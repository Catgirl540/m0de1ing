        <mxCell id="d2" value="&lt;b&gt;附件2&lt;/b&gt;&lt;br&gt;全年实际负荷&lt;br&gt;全年实际光伏功率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#5B9BD5;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
