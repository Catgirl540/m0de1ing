        <mxCell id="title" value="C题：微电网外部电网购电策略总体建模架构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
