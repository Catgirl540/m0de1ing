        <mxCell id="d1" value="&lt;b&gt;附件1&lt;/b&gt;&lt;br&gt;固定电价、典型日负荷&lt;br&gt;光伏预测功率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#5B9BD5;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
