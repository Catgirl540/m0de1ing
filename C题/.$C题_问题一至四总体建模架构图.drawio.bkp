          <mxGeometry x="710" y="105" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;附件4&lt;/b&gt;&lt;br&gt;全年每10分钟&lt;br&gt;实时波动电价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#5B9BD5;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
