        <mxCell id="model_title" value="预测与特征提取层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontColor=#375623;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="255" width="130" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="load_model" value="&lt;b&gt;负荷预测&lt;/b&gt;&lt;br&gt;傅里叶级数提取周期趋势&lt;br&gt;Haar小波修正局部残差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F9EF;strokeColor=#70AD47;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="180" y="255" width="350" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="pv_model" value="&lt;b&gt;光伏预测&lt;/b&gt;&lt;br&gt;截断幂正弦函数描述日照曲线&lt;br&gt;多时点预报线性插值与在线更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F9EF;strokeColor=#70AD47;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="255" width="400" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="price_model" value="&lt;b&gt;动态电价预测&lt;/b&gt;&lt;br&gt;傅里叶/正弦提取周期基线&lt;br&gt;小波重构尖峰残差 + 前一日同刻修正&lt;br&gt;非负截断保证价格合理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F9EF;strokeColor=#70AD47;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="970" y="255" width="570" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="q_title" value="四问递进建模层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontColor=#843C0C;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="130" height="275" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;问题一：确定性日前调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;典型日负荷与光伏拟合&lt;br&gt;每天0:00制定计划&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：线性规划 LP&lt;/b&gt;&lt;br&gt;目标：最小化单日购电费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#ED7D31;strokeWidth=2;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="430" width="315" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="q2" value="&lt;b&gt;问题二：预测误差下的全年调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;滚动历史预测 + 80%分位数备用&lt;br&gt;48小时优化抑制日末效应&lt;br&gt;缺口按5倍电价紧急购电&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：风险线性规划&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#ED7D31;strokeWidth=2;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="525" y="430" width="315" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;问题三：多时点预报滚动调整&lt;/b&gt;&lt;br&gt;&lt;br&gt;0、6、12、18时刻更新光伏预报&lt;br&gt;优化增加/减少购电量&lt;br&gt;比较不同更新策略&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：MPC-LP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#ED7D31;strokeWidth=2;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="430" width="315" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="q4" value="&lt;b&gt;问题四：实时波动电价扩展&lt;/b&gt;&lt;br&gt;&lt;br&gt;问题4-2：动态电价 + 风险LP/CVaR&lt;br&gt;问题4-3：电价在线修正 + MPC&lt;br&gt;实际电价回放结算&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：CVaR-LP + MPC-LP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFA;strokeColor=#8064A2;strokeWidth=2;fontColor=#1F2937;fontSize=14;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1215" y="430" width="325" height="215" as="geometry"/>
        </mxCell>

