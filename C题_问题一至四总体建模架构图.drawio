        <mxCell id="load_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;b&gt;动态负荷预测&lt;/b&gt;&lt;br&gt;年度谐波＋星期效应岭回归&lt;br&gt;历史融合＋傅里叶－Haar小波修正&lt;br&gt;严格前向贝叶斯优化＋早停" vertex="1">
