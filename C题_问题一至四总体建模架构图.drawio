        <mxCell id="q1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;问题一：确定性日前调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;典型日负荷与光伏拟合&lt;br&gt;每天0:00制定计划&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：线性规划 LP&lt;/b&gt;&lt;br&gt;目标：最小化单日购电费" vertex="1">
          <mxGeometry height="215" width="315" x="150" y="430" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;问题二：预测误差下的全年调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结训练集＋前向贝叶斯负荷预测&lt;br&gt;80%分位数备用＋48小时优化&lt;br&gt;缺口按5倍电价紧急购电&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：风险线性规划&lt;/b&gt;" vertex="1">
          <mxGeometry height="215" width="315" x="504" y="430" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;问题三：多时点预报滚动调整&lt;/b&gt;&lt;br&gt;&lt;br&gt;0、6、12、18时刻更新光伏预报&lt;br&gt;优化增加/减少购电量&lt;br&gt;验证集选S2、测试集最终评价&lt;br&gt;&lt;br&gt;&lt;b&gt;主算法：MPC-LP&lt;/b&gt;" vertex="1">
          <mxGeometry height="215" width="315" x="870" y="430" as="geometry" />
